        {
            "trip_headsign_regex": "^(.*)(not in service)(.*)$",
            "ignore_case": true
        }
    ],
    "trip_headsign_remove_via": true,
    "trip_headsign_cleaners": [
        {
            "regex": "(^\\d+([a-z]?)((\\s+)(\\w+))+((-| - | to )(.*))?$)",
            "ignore_case": true,
            "replacement": "$2 $8",
            "comment": "keep letter and distinct"
